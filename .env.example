# ------------------------------------------------------------------
# BarangayResolve environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ------------------------------------------------------------------

# Database. BarangayResolve uses PostgreSQL (the Prisma schema provider is
# "postgresql", so a local SQLite file: URL is NOT supported). Replace the
# placeholder below with a real connection string — a free Neon Postgres
# instance works well for development:
DATABASE_URL="postgresql://user:password@host:5432/barangayresolve"
# Optional direct (non-pooled) URL used for production schema migrations.
# Set this when DATABASE_URL points through a pooler (for example, Neon).
# DIRECT_URL="postgresql://user:password@host:5432/barangayresolve"

# ------------------------------------------------------------------
# Auth
# ------------------------------------------------------------------
# Long random string used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

# Whether the session cookie uses the Secure flag. Defaults to true when
# NODE_ENV=production. Set to "false" only for local testing over plain HTTP
# (e.g. running `next start` on localhost). Must be "true" on real HTTPS.
# SESSION_COOKIE_SECURE="true"

# ------------------------------------------------------------------
# Application
# ------------------------------------------------------------------
# APP_NAME=BarangayResolve

# Public origin of the deployed site. Used for canonical metadata and the web
# push registration origin check. Example: https://barangayresolve.vercel.app
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SLA windows. The revamp moved these into the database (SlaPolicy rows, managed
# on /admin/sla) so a stage, a service type or a priority can run on its own
# window. With no matching policy every open stage runs on the 48-hour default,
# and the hourly job in .github/workflows/sla-cron.yml escalates what is late.
# The old CASE_SLA_HOURS variable is retired: set the window in the SLA desk.

# Set to "true" when building for the Android/iOS Capacitor shell so the
# session cookie uses SameSite=None for the webview origin.
# NEXT_PUBLIC_CAPACITOR_APP="false"

# ------------------------------------------------------------------
# Personal data encryption (RA 10173) — REQUIRED in production
# ------------------------------------------------------------------
# One 32-byte secret. HKDF-SHA256 expands it into an AES-256-GCM key for field
# encryption (resident phone numbers, ID numbers) and an HMAC key for the
# lookup hashes used by duplicate detection. Accepts base64 (43+ chars), hex
# (64 chars) or a long passphrase (32+ bytes).
#
# Generate once:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Then encrypt existing plaintext phone numbers:
#   npm run privacy:pii-backfill            # dry run
#   npm run privacy:pii-backfill -- --apply # write the encrypted columns
#
# Losing this key makes every encrypted value unrecoverable. Rotating it means
# re-encrypting every ciphertext *and* re-deriving every lookup hash, which the
# rotation script does in one pass against the old key:
#   npm run privacy:pii-rotate            # dry run, reads PII_ENCRYPTION_KEY_PREVIOUS
#   npm run privacy:pii-rotate -- --apply # re-encrypts with PII_ENCRYPTION_KEY
#   npm run privacy:pii-rotate -- --verify
# During a rotation set both; afterwards remove the previous one (see
# docs/revamp/03-migration-plan.md §6).
#
# The values below are placeholders, not keys: anything under 32 bytes — and
# these exact strings — is rejected rather than used, so a deployment that
# copies them still cannot store personal data. `npm run env:check-pii` says
# which case applies. Set it in the hosting dashboard for a deployment (Vercel:
# Project Settings > Environment Variables) and redeploy. A deployment that
# deliberately stores no personal data can set ALLOW_MISSING_PII_KEY="true".
# PII_ENCRYPTION_KEY="replace-with-a-32-byte-secret"
# PII_ENCRYPTION_KEY_PREVIOUS="only-during-a-rotation"

# Audit chain key (HMAC, chain version 2). Keep it OUT of the database, so that
# someone who can rewrite the audit tables still cannot recompute valid hashes.
# At least 32 characters. Without it new audit rows are version 1 (unkeyed).
# Losing it makes version 2 rows unverifiable, so back it up with the other secrets.
# AUDIT_CHAIN_KEY="replace-with-a-32-plus-character-secret"

# ------------------------------------------------------------------
# SMTP progress emails (optional)
# ------------------------------------------------------------------
# Residents receive an email after a case status or progress note is recorded
# when these variables are configured. Leave them unset for in-app notices only.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="your-smtp-username"
# SMTP_PASSWORD="your-smtp-password"
# SMTP_FROM="BarangayResolve <no-reply@example.com>"

# Shared secret for the scheduled jobs. Every cron route requires
# `Authorization: Bearer $CRON_SECRET` and does nothing without it:
#   POST /api/v1/cron/email-deliveries   (email retry)
#   POST /api/v1/cron/sla-escalations    (48-hour escalation scan, hourly)
#   POST /api/v1/cron/audit-verify       (audit chain verification, weekly)
#   POST /api/v1/cron/retention          (privacy retention sweep, daily)
# CRON_SECRET="replace-with-a-long-random-cron-secret"

# ------------------------------------------------------------------
# Offline phone/browser push alerts (optional)
# ------------------------------------------------------------------
# Generate once with: npx web-push generate-vapid-keys
# VAPID_SUBJECT="mailto:admin@example.com"
# VAPID_PUBLIC_KEY="..."
# VAPID_PRIVATE_KEY="..."

# ------------------------------------------------------------------
# Native push — Firebase Cloud Messaging (Android)
# ------------------------------------------------------------------
# FCM is free on the Firebase Spark plan; no billing account or credit card
# is required. The server authenticates with a service account and sends via
# the FCM HTTP v1 API.
#
# Download the service account JSON from:
#   Firebase Console > Project settings > Service accounts > Generate new
#   private key  (choose the "firebase-adminsdk-xxxx" account)
#
# Save it OUTSIDE version control, e.g. <project>/secrets/firebase-service-account.json
# (the secrets/ directory is git-ignored), then point this variable at it.
# Never commit the JSON or inline its contents here.
# FIREBASE_SERVICE_ACCOUNT_PATH="C:/absolute/path/to/secrets/firebase-service-account.json"

# For serverless deployments such as Vercel, use the inline JSON value because
# the function cannot read a local service-account file at runtime.
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"..."}'

# ------------------------------------------------------------------
# Native push — APNs (iOS/macOS only; requires a paid Apple Developer account)
# ------------------------------------------------------------------
# APNS_KEY_PATH="C:/absolute/path/to/AuthKey_ABC1234567.p8"
# APNS_KEY_ID="ABC1234567"
# APNS_TEAM_ID="YOURTEAMID"
# APNS_BUNDLE_ID="com.barangayresolve.app"
# APNS_ENVIRONMENT="sandbox"   # or "production"

# ------------------------------------------------------------------
# File uploads
# ------------------------------------------------------------------
# Images default to database storage so they survive redeploys and work across
# app instances. To use disk, opt in ONLY with a persistent shared volume:
# UPLOAD_STORAGE="disk"
# Directory for disk storage (defaults to `<project>/uploads`). Images are
# served through an authenticated route, never directly.
# UPLOAD_DIR="./uploads"

# Per-user daily upload quota in bytes (default 25 MiB = 26214400).
# Can be changed at runtime via /admin/settings (key: uploads.daily_quota_bytes).
# UPLOAD_DAILY_QUOTA_BYTES="26214400"