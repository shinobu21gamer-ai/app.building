{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Next.js development server",
            "type": "shell",
            "command": "npm.cmd run dev -- --hostname 127.0.0.1",
            "isBackground": true,
            "problemMatcher": {
                "owner": "next",
                "pattern": {
                    "regexp": ".*",
                    "file": 1,
                    "location": 1,
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": "Ready in"
                }
            }
        }
    ]
}
