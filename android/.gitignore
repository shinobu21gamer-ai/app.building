# Using Android gitignore template: https://github.com/github/gitignore/blob/HEAD/Android.gitignore

# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
#  Uncomment the following line in case you need and you don't have the release build type files in your app
# release/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
# Android Studio 3 in .gitignore file.
.idea/caches
.idea/modules.xml
# Comment next line if keeping position of elements in Navigation Editor is relevant for you
.idea/navEditor.xml

# Keystore files
# Uncomment the following lines if you do not want to check your keystore files in.
#*.jks
#*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (e.g. APIs or Firebase)
# google-services.json

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Version control
vcs.xml

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/
# lint/reports/

# Android Profiling
*.hprof

# Cordova plugins for Capacitor
capacitor-cordova-android-plugins

# Copied web assets
app/src/main/assets/public

# Generated Config files
#
# capacitor.config.json and capacitor.plugins.json are generated by
# `npx cap sync android` and ARE tracked on purpose:
#
#   * capacitor.config.json carries `server.url`, the remote origin this
#     WebView app loads. If it is missing from the APK (e.g. the app was built
#     from a fresh checkout where `npx cap sync` never ran) Capacitor falls back
#     to the local bundle, which is empty for this app -> the app opens to a
#     blank/white screen.
#   * capacitor.plugins.json is the plugin registration list. Without it the
#     native plugins (splash screen, notifications, ...) are not registered.
#
# Keeping them in git means a plain `gradlew assembleDebug` from Android Studio
# still produces a working APK. `npm run android:apk` re-syncs them first, and
# CI verifies they match capacitor.config.ts (see .github/workflows/ci.yml).
app/src/main/res/xml/config.xml
