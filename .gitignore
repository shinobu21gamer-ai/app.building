# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# service account credentials (never commit)
/secrets
*.p8
*service-account*.json
firebase-adminsdk*.json

# Android release signing material (never commit)
*.jks
*.keystore
/android/keystore.properties

# Firebase Android app config (contains an API key; not for version control)
google-services.json
android/app/google-services.json

# machine-specific
/android/local.properties
/dev-url.txt

# database files
*.db
*.db-journal

# uploaded concern images
/uploads

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# session cookies / auth artifacts (may contain live JWTs — never commit)
*cookies*.txt
*cookie*.json
cookies*.json

# plaintext credentials / API test payloads (never commit)
login*.json
alert_*.json
status*.json
close.json
resolve.json
new_concern.json

# local logs and build artifacts
build.log
*.log

# stale generated docs
llms.txt
